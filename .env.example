# ---------------------------------------------------------------------------
# SchemePing environment template.
# Copy to .env and change every secret before deploying anywhere real.
# The non-empty values below are development-only. Add real provider
# credentials only to your untracked local `.env` file.
# ---------------------------------------------------------------------------

# ---- Application ----
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-change-me-before-any-real-deployment-000000

# Fernet key(s) used for application-level encryption of sensitive columns.
# Generate with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Comma-separate multiple keys to support rotation: the FIRST key encrypts new
# data, every key is tried when decrypting.
ENCRYPTION_KEY=1nS5NFwSoYVbHVFNZAdX-2L1B63shyOWmjn8b78mwG4=

# ---- Database ----
# Host `mysql` is the docker-compose service name. For running the backend on
# your host machine instead, use 127.0.0.1 here (see README).
DATABASE_URL=mysql+pymysql://schemeping:schemeping@mysql:3306/schemeping?charset=utf8mb4
MYSQL_DATABASE=schemeping
MYSQL_USER=schemeping
MYSQL_PASSWORD=schemeping
MYSQL_ROOT_PASSWORD=dev-root-password-change-me
# Host port for the MySQL container. 3307 avoids clashing with a local MySQL
# service on 3306. Change DATABASE_URL to 127.0.0.1:${MYSQL_HOST_PORT} when
# running the backend outside Docker.
MYSQL_HOST_PORT=3307

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- CORS (comma separated, no spaces) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Error monitoring (leave empty to disable) ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=development
# Frontend error monitoring (Vite variable, used by the PWA build).
VITE_SENTRY_DSN=

# ---- LLM (Gemini assistant and scheme explanations) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Assistant (Phase 6) ----
# Chat, simplification, and translation use the Gemini provider selected above.
# The Claude adapter is retained for later use and is not required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Per-user assistant quota and how much context is sent.
CHAT_RATE_LIMIT_PER_HOUR=20
CHAT_RECORD_LIMIT=6
# How long assistant transcripts are kept before the nightly purge.
CHAT_HISTORY_RETENTION_DAYS=14

# ---- Authentication ----
# password: mobile number + password (default; no SMS vendor, no DLT).
# otp: one-time code by SMS, using MESSAGING_PROVIDER below.
AUTH_MODE=password
PASSWORD_MIN_LENGTH=8

# ---- Messaging (Phase 5; log provider is free and is the dev default) ----
# Only used when AUTH_MODE=otp (and for WhatsApp templates in Phase 5).
# log: OTP goes to the backend console (free, dev/CI default).
# msg91: server-side OTP through MSG91; needs a DLT-registered sender + template.
# msg91_widget: MSG91 OTP Widget. MSG91 sends with its own DLT-registered sender
#   and default template (no DLT registration needed) and verifies the code in
#   the browser; the API exchanges its access token for the verified mobile.
MESSAGING_PROVIDER=log
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
# Only for MESSAGING_PROVIDER=msg91_widget (MSG91 dashboard -> OTP -> Widget).
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=

# ---- WhatsApp and proactive notifications ----
# mock: records sends without a network (dev/CI default).
# log: logs the send. meta: Meta Cloud API with approved templates.
# msg91: legacy provider option, with credentials and template IDs below.
WHATSAPP_PROVIDER=mock
# Meta WhatsApp Cloud API credentials; never commit real values.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_API_VERSION=v22.0
# WhatsApp Sender number owned by the MSG91 account.
MSG91_WHATSAPP_NUMBER=
# Comma-separated "template_name:msg91_template_id" pairs for the six
# pre-approved templates (exact texts: docs/whatsapp-templates.md).
MSG91_WHATSAPP_TEMPLATE_IDS=
# Shared secret the provider must present on the delivery-status webhook.
WHATSAPP_WEBHOOK_SECRET=change-me-whatsapp-webhook-secret
# Max user-initiated "Send to WhatsApp" summaries per user per hour.
SEND_WHATSAPP_HOURLY_LIMIT=10
# Celery send-task retry budget before a notification is marked failed.
SEND_NOTIFICATION_RETRIES=3
# Master switch for the beat schedules (daily scan 07:30, deadlines 10:00 IST).
NOTIFICATIONS_SCHEDULE_ENABLED=true
# Shared header key for the Phase 5 disaster endpoints (the Phase 6 staff
# panel uses username + password + TOTP instead).
ADMIN_API_KEY=dev-admin-key-change-me

# ---- Admin panel (Phase 6) ----
# Mount the SQLAdmin staff panel at /admin (username + password + TOTP).
ADMIN_PANEL_ENABLED=true
# Lifetime of a staff API token (minutes).
ADMIN_TOKEN_TTL_MINUTES=30

# ---- Production (docker-compose.prod.yml) ----
# The domain Caddy issues the TLS certificate for.
CADDY_DOMAIN=
# Read-only database user for Metabase (created by docker/mysql/init).
ANALYTICS_DB_USER=analytics_ro
ANALYTICS_DB_PASSWORD=change-me-analytics-readonly

# ---- Seed behaviour ----
# Set true to load sample (draft) schemes/facilities when the api container starts.
SEED_ON_START=false

# ---- Tests ----
# Only needed if pytest cannot create its database on the compose MySQL port.
# TEST_DATABASE_BASE_URL=mysql+pymysql://schemeping:schemeping@127.0.0.1:3307
