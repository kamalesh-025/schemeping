# ---------------------------------------------------------------------------
# Frontend development overrides. Copy to `.env.local` (gitignored) and change
# the values only if the defaults clash with something else on your machine.
# ---------------------------------------------------------------------------

# Where the Vite dev server proxies /api and /health. Must match the address the
# backend is listening on.
VITE_API_TARGET=http://127.0.0.1:8000

# Dev server port (default 5173).
VITE_DEV_PORT=5173

# API root the browser calls. Leave empty for same-origin `/api/v1`, which is
# what the Vite proxy, Caddy, and a Vercel rewrite expect. Set an absolute URL
# (for example https://api.schemeping.example/api/v1) only when the frontend is
# hosted on a different site than the API; that also needs CORS_ORIGINS on the
# backend and SameSite=None cookies.
VITE_API_BASE_URL=
